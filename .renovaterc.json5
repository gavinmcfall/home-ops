{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "github>gavinmcfall/home-ops//.renovate/autoMerge.json5",
    "github>gavinmcfall/home-ops//.renovate/changelogs.json5",
    "github>gavinmcfall/home-ops//.renovate/customManagers.json5",
    "github>gavinmcfall/home-ops//.renovate/grafanaDashboards.json5",
    "github>gavinmcfall/home-ops//.renovate/groups.json5",
    "github>gavinmcfall/home-ops//.renovate/labels.json5",
    "github>gavinmcfall/home-ops//.renovate/overrides.json5",
    "github>gavinmcfall/home-ops//.renovate/semanticCommits.json5",
    ":automergeBranch",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(America/New_York)",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  ignorePaths: [
    "**/*.sops.*",
    "**/resources/**",
    ".codex/**",
  ],
  flux: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  // Applying this label to a Renovate PR triggers an immediate rebase on the next run
  rebaseLabel: "renovate/force-rebase",
  packageRules: [
    {
      description: ["Skip major updates for stateful databases"],
      matchPackagePatterns: [
        "bitnamicharts/mariadb",
        "bitnamicharts/postgresql",
        "valkey/valkey",
        "rabbitmq",
        "postgres-init",
      ],
      matchDatasources: ["helm", "docker"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: ["Block qBittorrent 5.2.x — not whitelisted by MAM (2026-05-12). Re-evaluate when MAM lifts the banner."],
      matchPackageNames: ["ghcr.io/home-operations/qbittorrent"],
      allowedVersions: "<5.2.0",
    },
    {
      // spegel 0.8.0's spegel-registry Service sets
      // spec.trafficDistribution: PreferSameNode, which is alpha in k8s 1.33
      // behind PreferSameTrafficDistribution (beta 1.34, stable 1.35). This
      // cluster runs v1.33.1, so the apiserver rejects it outright:
      //   Unsupported value: "PreferSameNode": supported values: "PreferClose"
      // Merged as #2825 on 2026-10-18 in a 63-PR flush, stalled the
      // HelmRelease, reverted by #2828. Both dep names are listed: "spegel" is
      // the runtime HelmRelease chart (helm datasource, via the spegel
      // HelmRepository), "ghcr.io/spegel-org/helm-charts/spegel" is the
      // bootstrap OCI chart in kubernetes/bootstrap/helmfile.yaml (#2824).
      // Pinning only one lets Renovate re-raise the other.
      description: ["Block spegel 0.8.0+ — needs Kubernetes >= 1.34 (2026-10-18). Remove this rule once the cluster is upgraded; see #2828."],
      matchPackageNames: ["spegel", "ghcr.io/spegel-org/helm-charts/spegel"],
      allowedVersions: "<0.8.0",
    },
  ],
}
