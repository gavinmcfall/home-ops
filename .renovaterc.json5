{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "github>gavinmcfall/home-ops//.renovate/autoMerge.json5",
    "github>gavinmcfall/home-ops//.renovate/changelogs.json5",
    "github>gavinmcfall/home-ops//.renovate/customManagers.json5",
    "github>gavinmcfall/home-ops//.renovate/grafanaDashboards.json5",
    "github>gavinmcfall/home-ops//.renovate/groups.json5",
    "github>gavinmcfall/home-ops//.renovate/labels.json5",
    "github>gavinmcfall/home-ops//.renovate/overrides.json5",
    "github>gavinmcfall/home-ops//.renovate/semanticCommits.json5",
    ":automergeBranch",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(America/New_York)",
  ],
  dependencyDashboard: { title: "Renovate Dashboard 🤖" },
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  ignorePaths: [
    "**/*.sops.*",
    "**/resources/**",
    ".codex/**",
    // Cluster-template leftovers. They repeat the live HelmRepositories, so
    // every helm lookup saw each registry URL twice ("Excess registryUrls").
    // Not kept in step with the live versions any more.
    "bootstrap/templates/**",
  ],
  flux: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  // Applying this label to a Renovate PR triggers an immediate rebase on the next run
  rebaseLabel: "renovate/force-rebase",
  packageRules: [
    {
      description: ["Skip major updates for stateful databases"],
      matchPackageNames: [
        "/bitnamicharts/mariadb/",
        "/bitnamicharts/postgresql/",
        "/valkey/valkey/",
        "/rabbitmq/",
        "/postgres-init/",
      ],
      matchDatasources: ["helm", "docker"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: ["Block qBittorrent 5.2.x — not whitelisted by MAM (2026-05-12). Re-evaluate when MAM lifts the banner."],
      matchPackageNames: ["ghcr.io/home-operations/qbittorrent"],
      allowedVersions: "<5.2.0",
    },
    {
      // spegel 0.8.0's spegel-registry Service sets
      // spec.trafficDistribution: PreferSameNode, which is alpha in k8s 1.33
      // behind PreferSameTrafficDistribution (beta 1.34, stable 1.35). This
      // cluster runs v1.33.1, so the apiserver rejects it outright:
      //   Unsupported value: "PreferSameNode": supported values: "PreferClose"
      // Merged as #2825 on 2026-10-18 in a 63-PR flush, stalled the
      // HelmRelease, reverted by #2828. Both dep names are listed: "spegel" is
      // the runtime HelmRelease chart (helm datasource, via the spegel
      // HelmRepository), "ghcr.io/spegel-org/helm-charts/spegel" is the
      // bootstrap OCI chart in kubernetes/bootstrap/helmfile.yaml (#2824).
      // Pinning only one lets Renovate re-raise the other.
      description: ["Block spegel 0.8.0+ — needs Kubernetes >= 1.34 (2026-10-18). Remove this rule once the cluster is upgraded; see #2828."],
      matchPackageNames: ["spegel", "ghcr.io/spegel-org/helm-charts/spegel"],
      allowedVersions: "<0.8.0",
    },
    {
      // n8n publishes every release to Docker Hub straight away, but marks new
      // minors as pre-releases on GitHub for about a week before the `stable`
      // tag moves. Docker tags carry no pre-release flag, so Renovate proposed
      // 2.48.4 (and 3.x, all of it early access) while stable was 2.47.7.
      // followTag does not work with the docker datasource, so this bound is
      // raised by hand: when Docker Hub's `stable` tag reaches a new minor,
      // move the bound to the minor after it.
      //
      // The cluster is on 2.48.4 (a pre-release when it was merged). Going
      // back to 2.47.7 was tried on 2026-11-15 and failed: after reverting the
      // three extra migrations, 2.47.7 crash-looped parsing a trusted-source
      // record 2.48 had already rewritten in a newer format ("Invalid
      // discriminator value. Expected 1"). n8n downgrades are not safe once
      // the newer version has started. So: stay, and go no further.
      description: ["Hold n8n at 2.48.x — do not move further into pre-releases. Raise when Docker Hub's `stable` tag reaches the next minor (2026-11-16)."],
      matchPackageNames: ["docker.io/n8nio/n8n", "n8nio/n8n"],
      allowedVersions: "<2.49.0",
      // n8n is switched off (commented out in home-automation/kustomization.yaml,
      // 2026-11-16); its manifests and data are kept. No PRs while it is off.
      // Remove this line when it is turned back on.
      enabled: false,
    },
    {
      // tuppr (kubernetes/apps/system-upgrade/tuppr) upgrades Talos as soon as
      // a version bump merges. Patch releases get their own PR; without
      // separateMinorPatch Renovate folds a patch into a pending minor and
      // 1.13.x patches would stop appearing once 1.14 exists.
      description: ["Talos: patch bumps raised on their own (merging one starts a tuppr rollout). Never automerged."],
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/siderolabs/installer"],
      separateMinorPatch: true,
      automerge: false,
    },
    {
      description: ["Talos minor and major upgrades are done by hand — approve on the Dependency Dashboard to get a PR."],
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/siderolabs/installer"],
      matchUpdateTypes: ["minor", "major"],
      dependencyDashboardApproval: true,
    },
    {
      // alpine/k8s supplies kubectl to the VolSync restore drill
      // (kubernetes/apps/storage/volsync/app/restore-drill.yaml). kubectl is
      // only supported within one minor of the apiserver, and the cluster runs
      // Kubernetes 1.36 (Talos v1.13 supports nothing newer).
      // #2990 proposed 1.33.1 -> 1.37.2. To override, raise the bound here in
      // the same change that moves the cluster to the next minor.
      description: ["Hold alpine/k8s on the cluster's Kubernetes minor (1.36) — raise with the cluster, not before (2026-11-14). See #2990."],
      matchPackageNames: ["docker.io/alpine/k8s", "alpine/k8s"],
      allowedVersions: "<1.37.0",
    },
  ],
}
